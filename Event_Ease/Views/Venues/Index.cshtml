@model IEnumerable<Event_Ease.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h1>Venues</h1>
<form method="get" style="margin-bottom: 20px;">
    <input type="text" name="searchString" placeholder="Search venues..." />
    <button type="submit">Search</button>
</form>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Venue</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <tr>
                    <td>
                    </td>

                    <td>@item.VenueName</td>
                    <td>@item.Location</td>
                    <td>@item.Capacity</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn btn-sm btn-warning">Edit</a>

                        <a asp-action="Details" asp-route-id="@item.VenueId" class="btn btn-sm btn-info">Details</a>

                        <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn btn-sm btn-danger">Delete</a>

                        <a asp-controller="Events"
                           asp-action="ByVenue"
                           asp-route-venueId="@item.VenueId"
                           class="btn btn-sm btn-success">
                            View Events
                        </a>
                    </td>
                </tr>
            </tr>
        }
    </tbody>
</table>